# Development defaults (used when a variable is missing)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORE_HOST=localhost
NEXT_PUBLIC_STORE_PORT=3000

# Production (Vercel) example. Leave NEXT_PUBLIC_STORE_PORT empty so links use https://{slug}.yourdomain.com
# NEXT_PUBLIC_API_URL=https://neko-backend.onrender.com
# NEXT_PUBLIC_STORE_HOST=yourdomain.com
# NEXT_PUBLIC_STORE_PORT=
